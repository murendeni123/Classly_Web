# ─── SMTP (server-only, NEVER exposed to the browser) ────────────────────────
# Lead-form submissions are emailed via these credentials by the serverless
# route at app/api/contact. These are read on the server only — do NOT prefix
# with NEXT_PUBLIC, or the password would ship to the browser.
#
# For Google Workspace (info@classlyempowering.co.za):
#   SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_USER=<the mailbox>,
#   SMTP_PASS=<a 16-char App Password from https://myaccount.google.com/apppasswords>
# In production, set these in the Vercel project (Settings → Environment Variables).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=info@classlyempowering.co.za
SMTP_PASS=your-16-char-app-password
MAIL_TO=info@classlyempowering.co.za
MAIL_FROM=Classly Website <info@classlyempowering.co.za>

# Canonical site origin, used for absolute URLs in sitemap.xml / Open Graph tags.
NEXT_PUBLIC_SITE_URL=https://classlyempowering.co.za

# ─── Image sourcing (build-time only, never exposed to the browser) ───────────
# Run `node scripts/download-images.mjs` after adding keys to populate
# public/images/ with licensed stock photos. Review public/images/CREDITS.md
# before launch and keep it committed so attribution is always on record.

# Unsplash — free, 50 req/hr on demo key. Create an app at
# https://unsplash.com/developers and use the Access Key (not the Secret Key).
UNSPLASH_ACCESS_KEY=

# Pexels — free, 200 req/hr. Get a key at https://www.pexels.com/api/
PEXELS_API_KEY=

# Pixabay — free, 100 req/hr. Get a key at https://pixabay.com/api/docs/
PIXABAY_API_KEY=
